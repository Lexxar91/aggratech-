{
  "mode": "docker-limited",
  "python": "3.14.4",
  "postgres": "18.6",
  "network": "none",
  "read_only_root": true,
  "user": "65534:65534",
  "cap_drop": ["ALL"],
  "no_new_privileges": true,
  "seccomp": "Docker default; never unconfined",
  "python_ram_mib": 128,
  "sql_ram_mib": 256,
  "cpu": "0.5",
  "pids": 32,
  "python_case_seconds": 5,
  "batch_seconds": 45,
  "sql_statement_ms": 1500,
  "sql_lock_ms": 1000,
  "sql_connections": 4,
  "output_bytes": 65536,
  "controller_zip_expanded_bytes": 65536,
  "executor_hash_verified": true,
  "check_code_immutable": true,
  "cleanup": "remove own ephemeral task container; tmpfs only",
  "host_mounts": false,
  "privileged": false
}
