APP_DATABASE_URL=postgresql+asyncpg://aggratech:local-development@db:5432/aggratech
APP_JOB_LEASE_SECONDS=60
APP_JOB_MAX_ATTEMPTS=3
APP_WORKER_POLL_SECONDS=1
# docker-limited runner и mTLS настраиваются автоматически через Compose.
# Не публикуйте Docker daemon и runner-controller в публичную сеть.

# Для второго стенда задайте отдельное имя проекта, порты и named volumes.
# COMPOSE_PROJECT_NAME=aggratech-review
# APP_HTTP_PORT=18100
# MAILPIT_HTTP_PORT=18125
# JWT-ключ создаётся автоматически в app-secret; значение не выводится.
